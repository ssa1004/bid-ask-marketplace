# EditorConfig — IDE / 에디터 공통 들여쓰기 / 줄끝 / 인코딩 통일.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Markdown 은 trailing space 두 개가 줄바꿈 의미라 trim 끄기.
[*.md]
trim_trailing_whitespace = false

# YAML / JSON / Helm chart 값 / GitHub Actions / docker-compose: 2 칸이 관례.
[*.{yml,yaml,json}]
indent_size = 2

# Gradle wrapper / Makefile / shell script.
[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2

# Java / Kotlin / Gradle Kotlin DSL — 4 칸 (현 코드베이스와 일치).
[*.{java,kt,kts}]
indent_size = 4

# ── ktlint (org.jlleitschuh.gradle.ktlint) ─────────────────────────────────────
# 기존 코드베이스에 ktlint 를 도입하면서, 이미 일관되게 굳어진 house style 과 충돌하는
# "포매팅 의견" 성격의 규칙은 끄고, 실수를 잡아주는 규칙(import 정리 등)은 켠 채로 둔다.
# 전면 reformat 대신 ruleset 을 코드에 맞춘다 — 한 번에 수백 파일을 건드리지 않기 위함.
[*.{kt,kts}]
ktlint_code_style = intellij_idea
# port.in 등 hexagonal 패키지가 Kotlin 예약어 `in` 을 backtick 으로 쓰는 것은 의도적.
ktlint_standard_package-name = disabled
ktlint_standard_filename = disabled
# 함수/클래스 시그니처·인자·체인의 줄바꿈 강제는 현 스타일과 어긋나 끈다.
ktlint_standard_function-signature = disabled
ktlint_standard_class-signature = disabled
ktlint_standard_argument-list-wrapping = disabled
ktlint_standard_parameter-list-wrapping = disabled
ktlint_standard_parameter-list-spacing = disabled
ktlint_standard_chain-method-continuation = disabled
ktlint_standard_chain-wrapping = disabled
ktlint_standard_wrapping = disabled
ktlint_standard_statement-wrapping = disabled
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_string-template-indent = disabled
ktlint_standard_enum-wrapping = disabled
ktlint_standard_multiline-if-else = disabled
ktlint_standard_if-else-wrapping = disabled
ktlint_standard_condition-wrapping = disabled
ktlint_standard_function-expression-body = disabled
ktlint_standard_annotation = disabled
ktlint_standard_spacing-between-declarations-with-annotations = disabled
ktlint_standard_blank-line-before-declaration = disabled
ktlint_standard_no-empty-first-line-in-class-body = disabled
ktlint_standard_no-blank-line-in-list = disabled
ktlint_standard_no-multi-spaces = disabled
ktlint_standard_trailing-comma-on-call-site = disabled
ktlint_standard_trailing-comma-on-declaration-site = disabled
# import 정렬·들여쓰기 관례도 현 코드와 굳어진 형태가 있어 끈다. no-unused-imports 같은
# "죽은 코드 잡기" 규칙은 켜 둔다.
ktlint_standard_import-ordering = disabled
ktlint_standard_indent = disabled

# .gitignore / .gitattributes / .dockerignore 류.
[{.gitignore,.gitattributes,.dockerignore,.editorconfig}]
indent_size = 2
